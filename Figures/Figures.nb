                  RowBox[{"i", "-", "1"}], ")"}], "/", "n"}]}], "]"}]}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"pSinMatrixOrdered", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", 
                RowBox[{
                 RowBox[{"-", "j"}], "+", "1", "+", 
                 RowBox[{"Ceiling", "[", 
                  RowBox[{"n", "/", "2"}], "]"}]}]}], "]"}], "]"}], "=", 
             RowBox[{
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", "/", "n"}], "]"}], "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"2", "*", "Pi", "*", 
                RowBox[{"(", 
                 RowBox[{"j", "-", "1"}], ")"}], "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"i", "-", "1"}], ")"}], "/", "n"}]}], "]"}]}]}]}]}],
           "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
