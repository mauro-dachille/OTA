     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Interferometer", " ", "layer", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"see", " ", 
            RowBox[{"Sec", ".", " ", "IV"}], " ", "A", " ", "in", " ", "the", 
            " ", "manuscript"}], ")"}], ".", " ", "Time"}]}], "-", 
        "independent"}], ",", " ", 
       RowBox[{"we", " ", "need", " ", "to", " ", "compute", " ", "it", " ", 
        RowBox[{"once", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pCosMatrix", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{
            RowBox[{"Ceiling", "[", 
             RowBox[{"n", "/", "2"}], "]"}], "-", "1"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"pSinMatrixOrdered", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{
            RowBox[{"Ceiling", "[", 
             RowBox[{"n", "/", "2"}], "]"}], "-", "1"}]}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{"i", ",", "j"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "n"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"p1", ",", 
           RowBox[{"1", "/", 
            RowBox[{"Sqrt", "[", "n", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"EvenQ", "[", "n", "]"}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"pEven", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"i", "-", "1"}], ")"}]}], "/", 
              RowBox[{"Sqrt", "[", "n", "]"}]}]}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "2"}], ",", 
           RowBox[{"j", "<=", 
