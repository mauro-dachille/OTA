Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "following", " ", "functions", " ", "are", " ", "based", " ", 
    "on", " ", 
    RowBox[{"Sec", ".", " ", "IV"}], " ", "A", " ", "of", " ", "the", " ", 
    RowBox[{"manuscript", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "the", " ", "following"}], ",", " ", 
    RowBox[{
    "we", " ", "compute", " ", "the", " ", "symplectic", " ", "eigenvalues"}],
     ",", " ", 
    RowBox[{
    "the", " ", "parameters", " ", "for", " ", "the", " ", "real", " ", 
     "squeezers", " ", "and", " ", "the", " ", "interferometer", " ", 
     "layer"}], ",", " ", 
    RowBox[{"for", " ", "the", " ", "fraction", " ", "Laplacian", " ", 
     RowBox[{"Hamiltonian", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SymplecticEigVal", "[", 
     RowBox[{"n_", ",", "\[Alpha]_", ",", "m_", ",", "\[Epsilon]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"eps", "=", 
         RowBox[{"N", "[", "\[Epsilon]", "]"}]}], ",", 
        RowBox[{"lambdaPhi", "=", 
         RowBox[{"{", "}"}]}], ",", " ", 
        RowBox[{"lambdaPi", "=", 
         RowBox[{"{", "}"}]}], ",", " ", "dFlag"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", " ", 
         RowBox[{"i", "<=", "n"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"lambdaPhi", ",", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"FractionalHamiltonianMatrix\[Phi]", "[", 
                 RowBox[{"n", ",", "\[Alpha]", ",", "m", ",", "eps"}], "]"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "1"}], "]"}], "]"}], "*", 
               RowBox[{"Cos", "[", 
                RowBox[{"2", "*", "Pi", "*", 
                 RowBox[{"(", 
                  RowBox[{"k", "-", "1"}], ")"}], "*", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1"}], ")"}], "/", "n"}]}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lambdaPi", ",", 
            RowBox[{"1", "/", "eps"}]}], "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dFlag", "=", 
        RowBox[{"Re", "[", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"lambdaPhi", "*", "lambdaPi"}], "]"}], ",", "16"}], "]"}],
          "]"}]}]}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zN", "[", 
     RowBox[{"n_", ",", "\[Alpha]_", ",", "m_", ",", "\[Epsilon]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"eps", "=", 
         RowBox[{"N", "[", "\[Epsilon]", "]"}]}], ",", 
        RowBox[{"lambdaPhi", "=", 
         RowBox[{"{", "}"}]}], ",", " ", 
        RowBox[{"lambdaPi", "=", 
         RowBox[{"{", "}"}]}], ",", " ", "dFlag"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", " ", 
         RowBox[{"i", "<=", "n"}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"lambdaPhi", ",", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"FractionalHamiltonianMatrix\[Phi]", "[", 
                 RowBox[{"n", ",", "\[Alpha]", ",", "m", ",", "eps"}], "]"}], 
                "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "1"}], "]"}], "]"}], "*", 
               RowBox[{"Cos", "[", 
                RowBox[{"2", "*", "Pi", "*", 
                 RowBox[{"(", 
                  RowBox[{"k", "-", "1"}], ")"}], "*", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1"}], ")"}], "/", "n"}]}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"lambdaPi", ",", 
            RowBox[{"1", "/", "eps"}]}], "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dFlag", "=", 
        RowBox[{"-", 
         RowBox[{"SetPrecision", "[", 
          RowBox[{
           RowBox[{"0.5", "*", 
            RowBox[{"Log", "[", 
             RowBox[{"Re", "[", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"lambdaPhi", "/", "lambdaPi"}], "]"}], "]"}], "]"}]}], 
           ",", "16"}], "]"}]}]}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9669493994836082`*^9, 3.966949570116873*^9}, {
