       RowBox[{"ComplexSqPP", "=", 
        RowBox[{"{", "}"}]}], ",", "ComplexSqSquared", ",", 
       "\[IndentingNewLine]", 
       RowBox[{"p1", "=", 
        RowBox[{"{", "}"}]}], ",", "pCosMatrix", ",", "pSinMatrixOrdered", ",", 
       RowBox[{"pEven", "=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "PNFlag", ",", 
