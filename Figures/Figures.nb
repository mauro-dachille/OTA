                    RowBox[{"DiagonalMatrix", "[", "ComplexSqPP", "]"}]}], 
                    "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"AppendTo", "[", 
