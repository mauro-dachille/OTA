Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Maximum", " ", "quasi"}], "-", 
    RowBox[{"particle", " ", 
     RowBox[{"velocity", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"vmax", "[", 
      RowBox[{"n_", ",", "m_", ",", "\[Epsilon]_"}], "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"2", "\[Pi]", "*", 
           RowBox[{"k", "/", "n"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"m", "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"4", "/", 
                RowBox[{"\[Epsilon]", "^", "2"}]}], ")"}], "*", 
              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{"\[Pi]", "*", 
                 RowBox[{"k", "/", "n"}]}], "]"}], "^", "2"}]}]}], "]"}]}], 
          ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"First", " ", "appearance", " ", "of", " ", 
     RowBox[{"correlations", ".", " ", "Divided"}], " ", "by", " ", "n", " ", 
     RowBox[{"already", "!"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Tau]", "[", 
      RowBox[{"n_", ",", "M_", ",", "m_", ",", "\[Epsilon]_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"M", "*", "\[Epsilon]"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "n", "*", 
        RowBox[{"vmax", "[", 
         RowBox[{"M", ",", "m", ",", "\[Epsilon]"}], "]"}]}], ")"}]}]}], 
    ";"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.958458999172439*^9, 3.9584591418553467`*^9}, {
