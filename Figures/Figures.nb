                    RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}], "+", 
                    RowBox[{
                    RowBox[{"Sinh", "[", 
                    RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}], "*", 
                    RowBox[{"Cos", "[", 
                    RowBox[{"CSqAngleFlag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"(*", " ", 
                   RowBox[{"Let", " ", "us", " ", "build", " ", 
                    RowBox[{"CovMat", "."}]}], " ", "*)"}], 
                  "\[IndentingNewLine]", 
                  RowBox[{"ComplexSqSquared", "=", 
