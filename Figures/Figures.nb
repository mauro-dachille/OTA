    "1", " ", "for", " ", "intensity", " ", "errors", " ", "and", " ", "2", " ",
      "for", " ", "angle", " ", "errors", " ", "of", " ", "the", " ", "input",
      " ", 
     RowBox[{"state", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"EntropicMeasuresLowFreqErrors", "[", 
    RowBox[{
    "t_", ",", "timePoints_", ",", "n_", ",", "\[Alpha]_", ",", "m_", ",", 
     "\[Epsilon]_", ",", "M_", ",", "d_", ",", "ErrorParameter_", ",", 
     "stdPercentage_", ",", "NSamples_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eps", "=", 
        RowBox[{"N", "[", "\[Epsilon]", "]"}]}], ",", 
       RowBox[{"tInt", "=", "0."}], ",", "\[IndentingNewLine]", 
       RowBox[{"dNFlag", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"zNFlag", "=", 
