Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"R\[EAcute]nyi", "-", 
    RowBox[{
    "2", " ", "entanglement", " ", "entropy", " ", "of", " ", "the", " ", 
     "relativistic", " ", "theory", " ", "following", " ", "the", " ", 
     "quasi"}], "-", 
    RowBox[{"particle", " ", 
     RowBox[{"picture", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Renyi2EntanglementEntropyQFT", "[", 
     RowBox[{"t_", ",", "n_", ",", "M_", ",", "m_", ",", "\[Epsilon]_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "DispertionRelation", ",", " ", "GroupVelocity", ",", "NumberQP", ",", 
        "GGEDensityEntropy", ",", "\[IndentingNewLine]", "Part1", ",", 
        "Part2", ",", "Part3", ",", "Domain", ",", "\[IndentingNewLine]", 
        "ToBeSummedEE", ",", "\[IndentingNewLine]", "FinalEE"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Building", " ", "block", " ", 
        RowBox[{"functions", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"DispertionRelation", "[", "k_", "]"}], ":=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"m", "^", "2"}], "+", 
          RowBox[{"4", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"\[Pi]", "*", 
                RowBox[{"k", "/", "n"}]}], "]"}], "/", "\[Epsilon]"}], ")"}], 
            "^", "2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GroupVelocity", "[", "k_", "]"}], ":=", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"2", "*", "\[Pi]", "*", 
            RowBox[{"k", "/", "n"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"\[Epsilon]", "*", 
            RowBox[{"DispertionRelation", "[", "k", "]"}]}], ")"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NumberQP", "[", "k_", "]"}], ":=", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"1", "/", 
             RowBox[{"(", 
              RowBox[{"\[Epsilon]", "*", 
               RowBox[{"DispertionRelation", "[", "k", "]"}]}], ")"}]}], "+", 
            " ", 
            RowBox[{"(", 
             RowBox[{"\[Epsilon]", "*", 
              RowBox[{"DispertionRelation", "[", "k", "]"}]}], ")"}], "-", 
            "2"}], ")"}], "/", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "If", " ", "the", " ", "number", " ", "of", " ", "quasiparticles", " ",
           "is", " ", "zero", " ", "for", " ", "some", " ", "mode"}], ",", 
         " ", 
         RowBox[{"the", " ", "entanglement", " ", "is", " ", "also", " ", 
          RowBox[{"zero", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GGEDensityEntropy", "[", "k_", "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"NumberQP", "[", "k", "]"}], "!=", "0"}], ",", 
          RowBox[{"Simplify", "[", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"NumberQP", "[", "k", "]"}], "^", "2"}]}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"NumberQP", "[", "k", "]"}]}], ")"}], "^", "2"}]}], 
            "]"}], "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Function", " ", "to", " ", "be", " ", 
         RowBox[{"summed", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Domain", "[", "k_", "]"}], ":=", 
        RowBox[{"FractionalPart", "[", 
         RowBox[{"2", "*", 
          RowBox[{"GroupVelocity", "[", "k", "]"}], "*", 
          RowBox[{"t", "/", 
           RowBox[{"(", 
            RowBox[{"n", "*", "\[Epsilon]"}], ")"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
