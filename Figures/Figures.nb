             RowBox[{"n", "/", "2"}], "]"}]}], ",", " ", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"pCosMatrix", "[", 
