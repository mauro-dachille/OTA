                   "n"}]}]}], "}"}]}], "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tInt", "+=", 
          RowBox[{"t", "/", "timePoints"}]}], ";", "\[IndentingNewLine]", 
