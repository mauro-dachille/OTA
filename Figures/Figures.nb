           RowBox[{"PNFlag", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "PNFlag"}], "}"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Parameters", " ", "of", " ", 
        RowBox[{"interest", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"dNFlag", "=", 
