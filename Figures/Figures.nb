         RowBox[{"part", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", "k", "]"}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Do", " ", "not", " ", "use", " ", "i", " ", "and", " ", "j", " ", 
