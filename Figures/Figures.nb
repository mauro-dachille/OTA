Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "following", " ", "function", " ", "generates", " ", "the", " ",
     "time", " ", "evolution", " ", "of", " ", "the", " ", "covariance", " ", 
    "matrix", " ", "by", " ", "means", " ", "of", " ", "the", " ", "OTA", " ",
     "for", " ", "the", " ", "OBC", " ", "relativistic", " ", 
    RowBox[{"theory", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TimeEvolutionCovarianceMatrixOBC", "[", 
    RowBox[{
    "t_", ",", "\[CapitalDelta]t_", ",", "n_", ",", "m_", ",", 
     "\[Epsilon]_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "H\[Phi]", ",", "H\[Pi]", ",", "EigenValH\[Phi]", ",", " ", 
       "EigenVecH\[Phi]", ",", "\[IndentingNewLine]", "GammaNEigenVal", ",", 
       "GammaN", ",", "\[IndentingNewLine]", 
       RowBox[{"NewEigenVec", "=", " ", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "TallyFlag", ",", 
       " ", "PositionFlag", ",", "\[IndentingNewLine]", "OrthogonalZ", ",", 
       "BlockTN", ",", "\[IndentingNewLine]", "BN", ",", " ", "AN", ",", 
       "SSD", ",", "\[IndentingNewLine]", "InvBN", ",", "InvAN", ",", 
       "InvSSD", ",", "\[IndentingNewLine]", "SymplecticEigenVal", ",", "DN", 
       ",", "WilliamsonD", ",", "\[IndentingNewLine]", "PSTimeEvo", ",", 
       "\[IndentingNewLine]", "SSDProduct", ",", "\[IndentingNewLine]", 
       "TimeEvolutionCovMat", ",", "\[IndentingNewLine]", "CovMatTable", ",", 
       "i"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Hamiltonian", " ", 
       RowBox[{"matrix", "."}]}], " ", "*)"}], "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"H\[Phi]", " ", "=", " ", 
       RowBox[{"RelativisticHamiltonianMatrixOBC", "[", 
        RowBox[{"n", ",", "m", ",", "\[Epsilon]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
      RowBox[{"H\[Pi]", " ", "=", " ", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "n", "]"}], "/", "\[Epsilon]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Eigenvectors", " ", "and", " ", "eigenvalues", " ", "of", " ", 
        RowBox[{"H\[Phi]", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"EigenValH\[Phi]", ",", " ", "EigenVecH\[Phi]"}], "}"}], " ", 
       "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{"Eigensystem", "[", "H\[Phi]", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Diagonal", " ", "matrix", " ", 
        RowBox[{"\[CapitalGamma]N", "."}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"GammaNEigenVal", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"\[Epsilon]", "*", "EigenValH\[Phi]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"GammaN", "=", 
       RowBox[{"DiagonalMatrix", "[", "GammaNEigenVal", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Symplectic", " ", "eigenvalues", " ", "and", " ", "the", " ", 
        "corresponding", " ", "diagonal", " ", 
        RowBox[{"matrix", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SymplecticEigenVal", "=", 
       RowBox[{"EigenValH\[Phi]", "/", "GammaNEigenVal"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DN", "=", 
       RowBox[{"DiagonalMatrix", "[", "SymplecticEigenVal", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WilliamsonD", "=", 
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"DN", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "DN"}], "}"}]}], "}"}], "]"}]}], " ", ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Orthogonal", " ", "set", " ", "of", " ", "eigenvectors", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
          "in", " ", "a", " ", "given", " ", "subspace", " ", "with", " ", 
           "degenerate", " ", "eigenvalues"}], ")"}], "."}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"TallyFlag", " ", "=", " ", 
       RowBox[{"Tally", "[", 
        RowBox[{"EigenValH\[Phi]", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#1", "-", "#2"}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"(", 
             RowBox[{"-", "10"}], ")"}]}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", " ", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "[", "TallyFlag", "]"}]}], ",", " ", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PositionFlag", "=", 
