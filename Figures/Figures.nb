Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "same", " ", "for", " ", "the", " ", "R\[EAcute]nyi"}], "-", 
    RowBox[{"2", " ", "mutual", " ", 
     RowBox[{"information", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Renyi2MutualInformationQFT", "[", 
     RowBox[{
     "t_", ",", "n_", ",", "M_", ",", "d_", ",", "m_", ",", "\[Epsilon]_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "d2", ",", "\[IndentingNewLine]", "DispersionRelation", ",", " ", 
        "\[IndentingNewLine]", "GroupVelocity", ",", "\[IndentingNewLine]", 
        "NumberQP", ",", "GGEDensityEntropy", ",", "\[IndentingNewLine]", 
        "Part1", ",", "PartA", ",", "PartB", ",", "PartC", ",", 
        "\[IndentingNewLine]", "PartA2", ",", "PartB2", ",", "PartC2", ",", 
        "\[IndentingNewLine]", "DomainV", ",", "DomainDA", ",", "DomainDB", ",",
         "DomainDC", ",", "\[IndentingNewLine]", "ToBeSummedMI", ",", 
        "\[IndentingNewLine]", "FinalMI"}], "}"}], ",", "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Building", " ", "block", " ", 
        RowBox[{"functions", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"d2", "=", 
        RowBox[{"n", "-", 
         RowBox[{"2", "*", "M"}], "-", "d"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"DispersionRelation", "[", "k_", "]"}], ":=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"m", "^", "2"}], "+", 
          RowBox[{"4", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sin", "[", 
               RowBox[{"\[Pi]", "*", 
                RowBox[{"k", "/", "n"}]}], "]"}], "/", "\[Epsilon]"}], ")"}], 
            "^", "2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GroupVelocity", "[", "k_", "]"}], ":=", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", "*", "\[Pi]", "*", 
            RowBox[{"k", "/", "n"}]}], "]"}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"\[Epsilon]", "*", 
           RowBox[{"DispersionRelation", "[", "k", "]"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
