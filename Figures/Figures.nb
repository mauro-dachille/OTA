Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Fit", " ", "functions", " ", "up", " ", "to", " ", 
    RowBox[{"modes", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Linear", "."}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ComputeLinearFit", "[", 
      RowBox[{"data_", ",", "modes_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"data", ",", "modes"}], "]"}], ",", 
        RowBox[{
         RowBox[{"a", "*", "x"}], "+", "b"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", "x"}], "]"}], "//", 
      "Normal"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Algebraic", "."}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ComputeAlgebraicFit", "[", 
      RowBox[{"data_", ",", "modes_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"data", ",", "modes"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c", "+", 
           RowBox[{"b", "*", 
            RowBox[{
             RowBox[{"(", "x", ")"}], "^", "a"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"0.1", "<", "a", "<", "0.9"}], ",", 
            RowBox[{"d", ">", "0"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], ",", "x", ",", 
        RowBox[{"Method", "->", "\"\<NMinimize\>\""}], ",", 
        RowBox[{"MaxIterations", "->", "1000"}]}], "]"}], "//", "Normal"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Logarithmic", "."}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ComputeLogarithmicFit", "[", 
      RowBox[{"data_", ",", "modes_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{"data", ",", "modes"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "+", 
           RowBox[{"b", "*", 
            RowBox[{"Log", "[", 
             RowBox[{"x", "+", "c"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"b", ">", "0"}], ",", 
            RowBox[{"c", ">", "0"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "x", ",", 
        RowBox[{"Method", "->", "\"\<NMinimize\>\""}], ",", 
        RowBox[{"MaxIterations", "->", "1000"}]}], "]"}], "//", "Normal"}]}], 
    ";"}]}]}]], "Input",
 InitializationCell->True,
