                    "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"CovMatFlag", "=", 
                RowBox[{"0.5", "*", 
                 RowBox[{
                  RowBox[{"Transpose", "[", "PFlag", "]"}], ".", 
                  "ComplexSqSquared", ".", "PFlag"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"Renyi2Flag", ",", 
                 RowBox[{"Renyi2EntanglementEntropyGaussian", "[", 
                  RowBox[{"CovMatFlag", ",", "M"}], "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"MutualInformationFlag", ",", 
                 RowBox[{"Renyi2MutualInformationGaussian", "[", 
                  RowBox[{"CovMatFlag", ",", "M", ",", "d"}], "]"}]}], 
                "]"}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ErrorParameter", "==", "2"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"Errors", " ", "in", " ", "the", " ", 
             RowBox[{"angles", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"CSqIntensityFlag", "=", "CSqIntensityIdealFlag"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"CSqAngleFlag", "=", 
             RowBox[{"Transpose", "[", 
              RowBox[{"CSqNoiseConstantDev", "[", 
               RowBox[{
               "CSqAngleIdealFlag", ",", "stdPercentage", ",", "NSamples"}], 
               "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"i", "=", "1"}], ",", 
              RowBox[{"i", "<=", "NSamples"}], ",", 
              RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"Given", " ", "the", " ", "previous", " ", "lists"}], 
                ",", " ", 
                RowBox[{"we", " ", "directly", " ", "compute", " ", 
                 RowBox[{"S", ".", 
                  RowBox[{"Transpose", "[", "S", "]"}]}], " ", "for", " ", 
                 "the", " ", "complex", " ", 
                 RowBox[{"squeezer", "."}]}]}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"ComplexSqXX", "=", 
                RowBox[{
                 RowBox[{"Cosh", "[", 
                  RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}], "-", 
                 RowBox[{
                  RowBox[{"Sinh", "[", 
                   RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}], "*", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"CSqAngleFlag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"ComplexSqXP", "=", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"Sinh", "[", 
                   RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}]}], "*", 
                 RowBox[{"Sin", "[", 
                  RowBox[{"CSqAngleFlag", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"ComplexSqPX", "=", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"Sinh", "[", 
                   RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}]}], "*", 
                 RowBox[{"Sin", "[", 
                  RowBox[{"CSqAngleFlag", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"ComplexSqPP", "=", 
                RowBox[{
                 RowBox[{"Cosh", "[", 
                  RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}], "+", 
                 RowBox[{
                  RowBox[{"Sinh", "[", 
                   RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}], "*", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"CSqAngleFlag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", " ", 
                RowBox[{"Let", " ", "us", " ", "build", " ", 
                 RowBox[{"CovMat", "."}]}], " ", "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{"ComplexSqSquared", "=", 
                RowBox[{"ArrayFlatten", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"DiagonalMatrix", "[", "ComplexSqXX", "]"}], ",", 
                    RowBox[{"DiagonalMatrix", "[", "ComplexSqXP", "]"}]}], 
                    "}"}], ",", "\[IndentingNewLine]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"DiagonalMatrix", "[", "ComplexSqPX", "]"}], ",", 
                    RowBox[{"DiagonalMatrix", "[", "ComplexSqPP", "]"}]}], 
                    "}"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"CovMatFlag", "=", 
                RowBox[{"0.5", "*", 
                 RowBox[{
                  RowBox[{"Transpose", "[", "PFlag", "]"}], ".", 
                  "ComplexSqSquared", ".", "PFlag"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"Renyi2Flag", ",", 
                 RowBox[{"Renyi2EntanglementEntropyGaussian", "[", 
                  RowBox[{"CovMatFlag", ",", "M"}], "]"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"MutualInformationFlag", ",", 
                 RowBox[{"Renyi2MutualInformationGaussian", "[", 
                  RowBox[{"CovMatFlag", ",", "M", ",", "d"}], "]"}]}], 
                "]"}]}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "We", " ", "divide", " ", "everything", " ", "by", " ", "the", " ",
             "number", " ", "of", " ", "modes", " ", "and", " ", "we", " ", 
            "scale", " ", "by", " ", "100"}], ",", " ", 
           RowBox[{
           "as", " ", "we", " ", "did", " ", "for", " ", "the", " ", "other", 
            " ", 
            RowBox[{"figures", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Please", ",", " ", 
           RowBox[{
           "notice", " ", "that", " ", "for", " ", "the", " ", "low", " ", 
            "frequency", " ", "case"}], ",", " ", 
           RowBox[{
           "the", " ", "average", " ", "is", " ", "at", " ", "the", " ", 
            "level", " ", "of", " ", "the", " ", "entropic", " ", 
            RowBox[{"measures", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ErrorParameter", "==", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"Renyi2TablePlot", ",", 
              RowBox[{"{", 
