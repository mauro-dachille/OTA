Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Input", " ", "state", " ", "preparation", " ", "by", " ", "means", " ", 
    "of", " ", "the", " ", "result", " ", "in", " ", 
    RowBox[{"Sec", ".", " ", "III"}], " ", "B", " ", "in", " ", "the", " ", 
    RowBox[{"manuscript", ".", " ", "Switching"}], " ", "to", " ", "complex", 
    " ", "squeezers", " ", "is", " ", "needed", " ", "for", " ", "the", " ", 
    "error", " ", "analysis", " ", "on", " ", "the", " ", "state", " ", 
    RowBox[{"preparation", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"CSqIntensity", "[", 
     RowBox[{
     "t_", ",", "n_", ",", "\[Alpha]_", ",", "m_", ",", "\[Epsilon]_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"eps", "=", 
         RowBox[{"N", "[", "\[Epsilon]", "]"}]}], ",", 
        RowBox[{"dNFlag", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"zNFlag", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"CSqIntensityFlag", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dNFlag", "=", 
        RowBox[{"SymplecticEigVal", "[", 
         RowBox[{"n", ",", "\[Alpha]", ",", "m", ",", "eps"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zNFlag", "=", 
        RowBox[{"zN", "[", 
         RowBox[{"n", ",", "\[Alpha]", ",", "m", ",", "eps"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"CSqIntensityFlag", "=", 
        RowBox[{"0.5", "*", 
         RowBox[{"ArcCosh", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Cos", "[", 
             RowBox[{"dNFlag", "*", "t"}], "]"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"dNFlag", "*", "t"}], "]"}], "^", "2"}], "*", 
            RowBox[{"Cosh", "[", 
             RowBox[{"4", "*", "zNFlag"}], "]"}]}]}], "]"}]}]}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CSqAngle", "[", 
     RowBox[{
     "t_", ",", "n_", ",", "\[Alpha]_", ",", "m_", ",", "\[Epsilon]_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
