Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "following", " ", "function", " ", "generates", " ", "the", " ",
     "time", " ", "evolution", " ", "of", " ", "the", " ", "covariance", " ", 
    "matrix", " ", "by", " ", "means", " ", "of", " ", "the", " ", "OTA", " ",
     "for", " ", "the", " ", "fractional", " ", "Laplacian", " ", 
    RowBox[{"theory", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"TimeEvolutionCovarianceMatrix", "[", 
    RowBox[{
    "t_", ",", "\[CapitalDelta]t_", ",", "n_", ",", "\[Alpha]_", ",", "m_", ",",
      "\[Epsilon]_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "H\[Phi]", ",", "H\[Pi]", ",", "EigenValH\[Phi]", ",", " ", 
       "EigenVecH\[Phi]", ",", "\[IndentingNewLine]", "GammaNEigenVal", ",", 
       "GammaN", ",", "\[IndentingNewLine]", 
       RowBox[{"NewEigenVec", "=", " ", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "TallyFlag", ",", 
       " ", "PositionFlag", ",", "\[IndentingNewLine]", "OrthogonalZ", ",", 
       "BlockTN", ",", "\[IndentingNewLine]", "BN", ",", " ", "AN", ",", 
       "SSD", ",", "\[IndentingNewLine]", "InvBN", ",", "InvAN", ",", 
       "InvSSD", ",", "\[IndentingNewLine]", "SymplecticEigenVal", ",", "DN", 
       ",", "WilliamsonD", ",", "\[IndentingNewLine]", "PSTimeEvo", ",", 
       "\[IndentingNewLine]", "SSDProduct", ",", "\[IndentingNewLine]", 
       "TimeEvolutionCovMat", ",", "\[IndentingNewLine]", "CovMatTable", ",", 
       "i"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Hamiltonian", " ", 
       RowBox[{"matrix", "."}]}], " ", "*)"}], "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"H\[Phi]", " ", "=", " ", 
       RowBox[{"FractionalHamiltonianMatrix\[Phi]", "[", 
        RowBox[{"n", ",", "\[Alpha]", ",", "m", ",", "\[Epsilon]"}], "]"}]}], 
      ";", "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
      RowBox[{"H\[Pi]", " ", "=", " ", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "n", "]"}], "/", "\[Epsilon]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Eigenvectors", " ", "and", " ", "eigenvalues", " ", "of", " ", 
        RowBox[{"H\[Phi]", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"EigenValH\[Phi]", ",", " ", "EigenVecH\[Phi]"}], "}"}], " ", 
       "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{"Eigensystem", "[", "H\[Phi]", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Diagonal", " ", "matrix", " ", 
        RowBox[{"\[CapitalGamma]N", "."}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"GammaNEigenVal", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"\[Epsilon]", "*", "EigenValH\[Phi]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"GammaN", "=", 
       RowBox[{"DiagonalMatrix", "[", "GammaNEigenVal", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Symplectic", " ", "eigenvalues", " ", "and", " ", "the", " ", 
        "corresponding", " ", "diagonal", " ", 
        RowBox[{"matrix", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SymplecticEigenVal", "=", 
       RowBox[{"EigenValH\[Phi]", "/", "GammaNEigenVal"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DN", "=", 
       RowBox[{"DiagonalMatrix", "[", "SymplecticEigenVal", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"WilliamsonD", "=", 
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"DN", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "DN"}], "}"}]}], "}"}], "]"}]}], " ", ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Orthogonal", " ", "set", " ", "of", " ", "eigenvectors", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
          "in", " ", "a", " ", "given", " ", "subspace", " ", "with", " ", 
           "degenerate", " ", "eigenvalues"}], ")"}], "."}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"TallyFlag", " ", "=", " ", 
       RowBox[{"Tally", "[", 
        RowBox[{"EigenValH\[Phi]", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#1", "-", "#2"}], "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"(", 
             RowBox[{"-", "10"}], ")"}]}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", " ", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "[", "TallyFlag", "]"}]}], ",", " ", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"PositionFlag", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"EigenValH\[Phi]", ",", 
             RowBox[{"_", "?", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"#", "-", 
                   RowBox[{
                    RowBox[{"TallyFlag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"(", 
                   RowBox[{"-", "10"}], ")"}]}]}], "&"}], ")"}]}]}], "]"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"TallyFlag", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "==", "1"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"NewEigenVec", ",", " ", 
             RowBox[{"EigenVecH\[Phi]", "[", 
              RowBox[{"[", 
               RowBox[{"PositionFlag", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"OrthogonalZ", " ", "=", " ", 
             RowBox[{"Orthogonalize", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"EigenVecH\[Phi]", "[", 
                  RowBox[{"[", 
                   RowBox[{"PositionFlag", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", " ", 
                 RowBox[{"EigenVecH\[Phi]", "[", 
                  RowBox[{"[", 
                   RowBox[{"PositionFlag", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "}"}], ",",
                " ", "Dot"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"NewEigenVec", ",", 
              RowBox[{"OrthogonalZ", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"NewEigenVec", ",", " ", 
              RowBox[{"OrthogonalZ", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}], "]"}]}]}], "]"}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"T", " ", "given", " ", "by", " ", "the", " ", "polar", " ", 
        RowBox[{"decomposition", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"BlockTN", " ", "=", " ", 
       RowBox[{"Normalize", "/@", "NewEigenVec"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Normalize", " ", "the", " ", "orthogonal", " ", "eigenvectors", " ", 
        "to", " ", "define", " ", 
        RowBox[{"BN", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"BN", " ", "=", " ", 
       RowBox[{
        RowBox[{"Sqrt", "[", "GammaNEigenVal", "]"}], "*", "BlockTN"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Define", " ", "A", " ", "and", " ", "SSD", " ", 
        RowBox[{"matrices", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"AN", " ", "=", " ", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"Inverse", "[", "GammaN", "]"}], ".", "BN"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SSD", " ", "=", " ", 
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"BN", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "AN"}]}], "}"}]}], "}"}], "]"}]}], " ", ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Invert", " ", 
        RowBox[{"matrices", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"InvBN", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "BN", "]"}], ".", 
        RowBox[{"Inverse", "[", "GammaN", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"InvAN", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "AN", "]"}], ".", "GammaN"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"InvSSD", "=", 
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"InvBN", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"-", "InvAN"}]}], "}"}]}], "}"}], "]"}]}], " ", ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "SSD", " ", "product", " ", "appearing", " ", "in", " ", "the", " ", 
         "middle", " ", "of", " ", "the", " ", "time"}], "-", 
        RowBox[{"evolved", " ", "covariance", " ", 
         RowBox[{"matrix", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"SSDProduct", "=", 
       RowBox[{"ArrayFlatten", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"GammaN", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Inverse", "[", "GammaN", "]"}]}], "}"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "PS", " ", "in", " ", "the", " ", "middle", " ", "of", " ", "the", " ", 
        RowBox[{"decomposition", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
