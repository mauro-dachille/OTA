      RowBox[{
       RowBox[{
        RowBox[{"\[Omega]Flag", "[", "i_", "]"}], ":=", 
        RowBox[{"N", "[", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"m", "^", "2"}], "+", 
