            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"ErrorParameter", "==", "2"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{"Errors", " ", "in", " ", "the", " ", 
                RowBox[{"angles", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"CSqIntensityFlag", "=", "CSqIntensityIdealFlag"}], ";",
                "\[IndentingNewLine]", 
               RowBox[{"CSqAngleFlag", "=", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"CSqNoiseConstantDev", "[", 
                  RowBox[{
                  "CSqAngleIdealFlag", ",", "stdPercentage", ",", 
                   "NSamples"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"For", "[", 
                RowBox[{
                 RowBox[{"i", "=", "1"}], ",", 
                 RowBox[{"i", "<=", "NSamples"}], ",", 
                 RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                   RowBox[{
                   "Given", " ", "the", " ", "previous", " ", "lists"}], ",", 
                   " ", 
                   RowBox[{"we", " ", "directly", " ", "compute", " ", 
                    RowBox[{"S", ".", 
                    RowBox[{"Transpose", "[", "S", "]"}]}], " ", "for", " ", 
                    "the", " ", "complex", " ", 
                    RowBox[{"squeezer", "."}]}]}], " ", "*)"}], 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"ComplexSqXX", "=", 
                   RowBox[{
                    RowBox[{"Cosh", "[", 
                    RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}], "-", 
                    RowBox[{
                    RowBox[{"Sinh", "[", 
                    RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}], "*", 
                    RowBox[{"Cos", "[", 
                    RowBox[{"CSqAngleFlag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"ComplexSqXP", "=", 
                   RowBox[{
                    RowBox[{"-", 
                    RowBox[{"Sinh", "[", 
                    RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}]}], "*", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"CSqAngleFlag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"ComplexSqPX", "=", 
                   RowBox[{
                    RowBox[{"-", 
                    RowBox[{"Sinh", "[", 
                    RowBox[{"2", "*", "CSqIntensityFlag"}], "]"}]}], "*", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"CSqAngleFlag", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"ComplexSqPP", "=", 
                   RowBox[{
