Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Define", " ", "the", " ", "Hamiltonian", " ", "matrix", " ", "H", " ", 
     "for", " ", "the", " ", "fractional", " ", "Laplacian", " ", 
     RowBox[{"theory", ":", " ", 
      RowBox[{"n", " ", "modes"}]}]}], ",", " ", 
    RowBox[{"exponent", " ", "\[Alpha]"}], ",", " ", 
    RowBox[{"mass", " ", "m"}], ",", " ", 
    RowBox[{"lattice", " ", "spacing", " ", 
     RowBox[{"\[Epsilon]", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FractionalHamiltonianMatrix\[Phi]", "[", 
      RowBox[{"n_", ",", "\[Alpha]_", ",", "m_", ",", "\[Epsilon]_"}], "]"}], 
     ":=", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"H\[Phi]", ",", "i", ",", "j"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"H\[Phi]", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", "1"}], ",", 
           RowBox[{"i", "<=", "n"}], ",", 
           RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "<=", "n"}], ",", 
             RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"H\[Phi]", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "/", "\[Epsilon]"}], ")"}], "*", 
                  RowBox[{"Exp", "[", 
                   RowBox[{
                    RowBox[{"-", "2"}], "*", "I", "*", "Pi", "*", "k", "*", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"i", "-", "j"}], ")"}], "/", "n"}]}], "]"}], "*", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2", "*", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"\[Pi]", "*", 
                    RowBox[{"k", "/", "n"}]}], "]"}]}], ")"}], "^", 
                    "\[Alpha]"}], ")"}], "/", "n"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "0", ",", 
                   RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "+", " ", 
               RowBox[{
                RowBox[{"KroneckerDelta", "[", 
                 RowBox[{"i", ",", "j"}], "]"}], "*", "\[Epsilon]", "*", 
                RowBox[{"m", "^", "\[Alpha]"}]}]}]}]}], "]"}]}], "]"}], ";", 
         "H\[Phi]"}]}], "]"}], "//", "N"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Define", " ", "the", " ", "corresponding", " ", "coupling", " ", 
     "strength", " ", 
     RowBox[{
      SubscriptBox["f", "M"], "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FractionalCoupling", "[", 
      RowBox[{"n_", ",", "\[Alpha]_", ",", "\[Epsilon]_", ",", "M_"}], "]"}], 
     ":=", 
     RowBox[{"Abs", "[", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "\[Epsilon]"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], "*", "I", "*", "\[Pi]", "*", "M", "*", 
           RowBox[{"k", "/", "n"}]}], "]"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[Pi]", "*", 
                RowBox[{"k", "/", "n"}]}], "]"}]}], ")"}], "^", "\[Alpha]"}], 
           ")"}], "/", "n"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
