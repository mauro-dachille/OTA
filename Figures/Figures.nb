              RowBox[{"DispersionRelation", "[", "k", "]"}]}], ")"}], "-", 
            "2"}], ")"}], "/", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"GGEDensityEntropy", "[", "k_", "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"NumberQP", "[", "k", "]"}], "!=", "0"}], ",", 
          RowBox[{"Simplify", "[", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"NumberQP", "[", "k", "]"}], "^", "2"}]}], "+", 
