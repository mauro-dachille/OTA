Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "SqDrift", " ", "produces", " ", "NSamples", " ", "of", " ", "points", " ",
     "with", " ", "standard", " ", "deviation", " ", "\[Sigma]", " ", 
    "around", " ", "the", " ", "average", " ", "values", " ", "defined", " ", 
    "by", " ", "the", " ", "input", " ", 
    RowBox[{"array", ".", " ", "It"}], " ", "will", " ", "be", " ", "used", " ",
     "for", " ", "errors", " ", "in", " ", "the", " ", 
    RowBox[{"intensity", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"CSqNoise", "[", 
     RowBox[{"averageList_", ",", "stdPercentage_", ",", "NSamples_"}], "]"}],
     ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Sigma]", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"SqFlag", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Sigma]", "=", 
        RowBox[{"stdPercentage", "*", "averageList"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", " ", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "averageList", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"averageList", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "==", "0."}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"When", " ", "centered", " ", "around", " ", "zero"}], ",",
              " ", 
             RowBox[{
             "standard", " ", "variance", " ", "set", " ", "equal", " ", "to",
               " ", 
              RowBox[{"zero", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"SqFlag", ",", 
             RowBox[{"RandomVariate", "[", 
              RowBox[{
               RowBox[{"NormalDistribution", "[", 
                RowBox[{
                 RowBox[{"averageList", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", "0.0001"}], "]"}], ",",
                "NSamples"}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"SqFlag", ",", 
             RowBox[{"RandomVariate", "[", 
              RowBox[{
               RowBox[{"NormalDistribution", "[", 
                RowBox[{
                 RowBox[{"averageList", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"\[Sigma]", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], ",", 
               "NSamples"}], "]"}]}], "]"}]}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "SqFlag"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "GlobalSqDrift", " ", "produces", " ", "NSamples", " ", "of", " ", 
     "points", " ", "with", " ", "a", " ", "costant", "  ", "standard", " ", 
     RowBox[{"deviation", ".", " ", "It"}], " ", "will", " ", "be", " ", 
     "used", " ", "for", " ", "errors", " ", "in", " ", "the", " ", 
     RowBox[{"angles", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CSqNoiseConstantDev", "[", 
     RowBox[{"averageList_", ",", "stdPercentage_", ",", "NSamples_"}], "]"}],
     ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"SqFlag", "=", 
        RowBox[{"{", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", " ", 
         RowBox[{"i", "<=", 
          RowBox[{"Length", "[", "averageList", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"SqFlag", ",", 
           RowBox[{"RandomVariate", "[", 
            RowBox[{
             RowBox[{"NormalDistribution", "[", 
              RowBox[{
               RowBox[{"averageList", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"Abs", "[", "stdPercentage", "]"}]}], "]"}], ",", 
             "NSamples"}], "]"}]}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "SqFlag"}]}], "]"}]}]}]}]], "Input",
