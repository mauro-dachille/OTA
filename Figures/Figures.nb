Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EntropicMeasuresWithLoss", "[", 
    RowBox[{
    "time_", ",", "timePoints_", ",", "ModeNumber_", ",", "MSize_", ",", 
     "Distance_", ",", "data_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tInt", "=", "0."}], ",", 
       RowBox[{"Renyi2LossTablePlot", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"MILossTablePlot", "=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Renyi2LossTablePlotEnd", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"MILossTablePlotEnd", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", "k", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", "1"}], ",", 
        RowBox[{"k", "<=", 
         RowBox[{"timePoints", "+", "1"}]}], ",", 
        RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
