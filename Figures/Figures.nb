             RowBox[{"ConstantArray", "[", 
              RowBox[{"\[Mu]", ",", 
               RowBox[{"n", "-", "2"}]}], "]"}], ",", 
             RowBox[{"\[Mu]", "+", "\[Nu]"}]}], "}"}], ",", "1"}], "]"}], 
         "]"}], "\[IndentingNewLine]", "+", 
        RowBox[{"DiagonalMatrix", "[", 
